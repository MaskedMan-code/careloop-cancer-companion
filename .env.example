# Copy to .env.local for local development. NEVER commit real keys.
# On Vercel: Project -> Settings -> Environment Variables (see README).
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Opt-in loopback development only. Ignored on Vercel. Do not enable on a public host.
CARELOOP_LOCAL_DEMO=1
# Public/preview deployments: randomly generate at least 32 characters; share privately with judges.
CARELOOP_DEMO_ACCESS_CODE=
# Durable shared quota storage (Upstash Redis REST, read/write token, HTTPS).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Aggregate paid attempts per UTC day; all judges share this budget. Range 1..1000.
CARELOOP_AI_DAILY_LIMIT=100
