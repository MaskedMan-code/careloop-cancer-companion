{
  "name": "careloop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "description": "CareLoop — a dual AI + Human Cancer Care Companion prototype for Health-a-thon 2026 (fictional data; non-clinical).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "lucide-react": "0.383.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vitest": "5.0.5"
  }
}
